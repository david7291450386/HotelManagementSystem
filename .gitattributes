# Automatically detect text files
* text=auto

# Python source files
*.py text eol=lf
*.pyi text eol=lf

# Project configuration
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sql text eol=lf

# Markdown documentation
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Microsoft Word documents
*.docx binary
*.doc binary

# PDF documents
*.pdf binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary

# Archives
*.zip binary
*.7z binary

# Database files
*.db binary
*.sqlite binary
*.sqlite3 binary